{
  "name": "pi-simplify-code",
  "version": "0.1.0",
  "description": "Auto-trigger code simplification follow-ups after code edits in pi.",
  "type": "module",
  "main": "./dist/index.js",
  "keywords": ["pi-package", "pi", "extension", "refactor"],
  "pi": {
    "extensions": ["./src/index.ts"],
    "image": "https://raw.githubusercontent.com/vedang/pi-simplify-code/main/images/banner.png"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "test": "vitest run --config vitest.config.unit.ts",
    "test:watch": "vitest --config vitest.config.unit.ts",
    "test:coverage": "vitest run --config vitest.config.unit.ts --coverage"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.3.0",
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jscpd": "^4.0.8",
    "knip": "^5.86.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
